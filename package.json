{
  "name": "zuno",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "dev:api": "wrangler dev --port 8787 --local",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:icons": "tauri icon src-tauri/icons/zuno-app-icon.svg -o src-tauri/icons",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --format=esm --platform=neutral --main-fields=module,main --outfile=dist-worker/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "db:local": "wrangler d1 execute zuno-db --local --file=schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.4.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
